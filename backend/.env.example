# Backend environment variables.
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is gitignored — never commit real credentials.

# --- Django -------------------------------------------------------------
# Generate a fresh value for every deployment.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Database (only used when DB_ENGINE=mysql) --------------------------
# Leave DB_ENGINE unset to use SQLite (default for local development).
# DB_ENGINE=mysql
# DB_NAME=alumni_network
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=db
# DB_PORT=3306

# --- Email --------------------------------------------------------------
# Leave EMAIL_HOST_USER and EMAIL_HOST_PASSWORD unset to use Django's
# console backend (emails print to stdout instead of being delivered) —
# perfect for local development without real SMTP credentials.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-address@example.com

# --- Optional auto-superuser (Docker entrypoint) ------------------------
# If all three are set, entrypoint.sh creates a superuser on first boot.
# If any is missing, no auto-superuser is created. Use strong values.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
