# Frontend environment variables (Expo).
# Copy to `.env` and fill in for your environment. Anything prefixed with
# EXPO_PUBLIC_ is inlined into the client bundle at build time.

# Universal API base URL — used on every platform unless a per-platform
# override is also set. Pick the form that matches how the device reaches
# your backend:
#   Local web dev:           http://localhost:8000/api
#   Same LAN (phone/laptop): http://<your-laptop-ip>:8000/api
#   Production:              https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Optional per-platform overrides (uncomment if needed):
# EXPO_PUBLIC_API_URL_WEB=http://localhost:8000/api
# EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:8000/api
# EXPO_PUBLIC_API_URL_IOS=http://localhost:8000/api
